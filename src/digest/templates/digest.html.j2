<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Nibbles Pulse — {{ digest.date.strftime("%a, %b %-d") }} · Sentiment {{ digest.sentiment_score }}{% if digest.sentiment_delta_vs_7d >= 0 %} (+{{ digest.sentiment_delta_vs_7d }}){% else %} ({{ digest.sentiment_delta_vs_7d }}){% endif %}</title>
<style>
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:#F5F5F7;color:#111113;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  .wrap{max-width:640px;margin:32px auto;padding:0 20px}
  .card{background:#FFFFFF;border-radius:18px;padding:36px 40px;box-shadow:0 1px 2px rgba(0,0,0,.04),0 8px 40px rgba(0,0,0,.06)}
  .wordmark{font-size:11px;letter-spacing:.18em;color:#6E6E73;text-transform:uppercase}
  .date{float:right;font-size:12px;color:#6E6E73}
  .hero-num{font-family:-apple-system,"SF Pro Display",system-ui,sans-serif;font-weight:600;font-size:120px;line-height:1;letter-spacing:-4px;margin:18px 0 6px;color:#111113}
  .delta{display:inline-block;font-size:14px;font-weight:600}
  .delta.pos{color:#30D158}
  .delta.neg{color:#FF453A}
  .hero-sub{font-size:13px;color:#6E6E73;margin-top:2px;letter-spacing:.02em}
  .headline{font-family:-apple-system,"SF Pro Display",system-ui,sans-serif;font-weight:600;font-size:22px;line-height:1.3;color:#111113;margin:20px 0 4px;letter-spacing:-.2px}
  h2{font-family:-apple-system,"SF Pro Display",system-ui,sans-serif;font-weight:600;font-size:11px;letter-spacing:.16em;color:#6E6E73;text-transform:uppercase;margin:34px 0 12px}
  .hair{border-top:1px solid #E5E5EA;margin:28px 0}
  .row{display:flex;gap:14px;align-items:flex-start;padding:12px 0;border-bottom:1px solid #E5E5EA}
  .row:last-child{border-bottom:0}
  .dot{width:8px;height:8px;border-radius:50%;margin-top:9px;flex:0 0 auto}
  .dot.pos{background:#30D158}
  .dot.neg{background:#FF453A}
  .dot.neu{background:#6E6E73}
  .row-body{flex:1}
  .row-title{font-size:15px;font-weight:600;color:#111113;letter-spacing:-.1px}
  .row-meta{font-size:13px;color:#6E6E73;margin-top:2px}
  .quote-card{background:#F2F2F7;border-radius:14px;padding:14px 16px;margin:10px 0}
  .quote-text{font-size:14.5px;color:#3A3A3C;line-height:1.45}
  .quote-src{font-size:12px;color:#6E6E73;margin-top:8px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  .pill{display:inline-block;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border-radius:999px;background:#EAEAEF;color:#3A3A3C;margin-right:4px}
  .pill.appstore{background:#E8F4FF;color:#0055CC}
  .alert{background:#FFF4E0;border:1px solid #FFE3AE;color:#7A4E00;border-radius:12px;padding:10px 14px;font-size:13.5px;margin-bottom:18px}
  .trend-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid #E5E5EA;font-size:14px}
  .trend-row:last-child{border:0}
  .trend-q{color:#111113;font-weight:500}
  .trend-d{color:#30D158;font-variant-numeric:tabular-nums;font-weight:600;font-size:13px}
  .spark{width:120px;height:28px}
  .foot{font-size:11.5px;color:#6E6E73;line-height:1.5;margin-top:26px}
  .post-links{font-size:11px;color:#6E6E73;margin-left:2px;display:inline-flex;gap:8px}
  .post-links a{color:#6E6E73;text-decoration:underline dotted}
  .post-links a:hover{color:#007AFF;text-decoration:underline}
  .leadership{background:#F7F7FA;border-radius:14px;padding:14px 16px;margin-top:16px;border:1px solid #E5E5EA}
  .leadership-title{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:#6E6E73;margin-bottom:8px}
  .stars{color:#FF9F0A;letter-spacing:-1px}
  .appstore-row{padding:10px 0;border-bottom:1px solid #E5E5EA}
  .appstore-row:last-child{border-bottom:0}
  .appstore-title{font-size:14px;font-weight:600;color:#111113}
  .appstore-body{font-size:13px;color:#3A3A3C;margin-top:3px;line-height:1.45}
  .appstore-meta{font-size:11.5px;color:#6E6E73;margin-top:4px;display:flex;align-items:center;gap:8px}
  a{color:#007AFF;text-decoration:none}
  a:hover{text-decoration:underline}
  @media (max-width:520px){.card{padding:26px 22px}.hero-num{font-size:92px}}
</style>
</head>
<body>
  <div class="wrap"><div class="card">

    <div>
      <span class="wordmark">Nibbles Pulse</span>
      <span class="date">{{ digest.date.strftime("%A, %B %-d, %Y") }}</span>
    </div>

    {% for a in digest.alerts %}
    <div class="alert">
      <strong>Alert:</strong> {{ a.human_readable }}
      {% set src = source_url(a.supporting_item_ids[0]) if a.supporting_item_ids else '' %}
      <span class="post-links">[<a href="{{ flag_url(a.supporting_item_ids[0] if a.supporting_item_ids else 'alert', 'alert') }}">flag</a>{% if src %} · <a href="{{ src }}" target="_blank">source ↗</a>{% endif %}]</span>
    </div>
    {% endfor %}

    <div class="hero-num">{{ digest.sentiment_score }}</div>
    <div>
      <span class="delta {{ 'pos' if digest.sentiment_delta_vs_7d >= 0 else 'neg' }}">
        {{ '▲ +' if digest.sentiment_delta_vs_7d > 0 else ('▼ ' if digest.sentiment_delta_vs_7d < 0 else '· ') }}{{ digest.sentiment_delta_vs_7d }}
      </span>
      <span class="hero-sub">Daily Sentiment · vs. prior · {{ digest.items_analyzed }} items analyzed</span>
    </div>
    <div class="headline">{{ digest.headline }}</div>

    <div class="hair"></div>

    {% if digest.loved %}
    <h2>What customers loved</h2>
    {% for t in digest.loved %}
    <div class="row">
      <span class="dot pos"></span>
      <div class="row-body">
        <div class="row-title">{{ t.theme }} — "{{ t.one_line }}"</div>
        <div class="row-meta">
          {{ t.count }} mentions · confidence {{ "%.0f"|format(avg_conf(t.supporting_item_ids) * 100) }}%
          {% set src = source_url(t.supporting_item_ids[0]) if t.supporting_item_ids else '' %}
          {% set lbl = source_label(t.supporting_item_ids[0]) if t.supporting_item_ids else '' %}
          <span class="post-links">
            [<a href="{{ flag_url(t.supporting_item_ids[0], 'loved') }}">flag</a>{% if src %} · <a href="{{ src }}" target="_blank">{{ lbl }} ↗</a>{% endif %}]
          </span>
        </div>
      </div>
    </div>
    {% endfor %}
    {% endif %}

    {% if digest.disliked %}
    <h2>What customers disliked</h2>
    {% for t in digest.disliked %}
    <div class="row">
      <span class="dot neg"></span>
      <div class="row-body">
        <div class="row-title">{{ t.theme }} — "{{ t.one_line }}"</div>
        <div class="row-meta">
          {{ t.count }} mentions · confidence {{ "%.0f"|format(avg_conf(t.supporting_item_ids) * 100) }}%
          {% set src = source_url(t.supporting_item_ids[0]) if t.supporting_item_ids else '' %}
          {% set lbl = source_label(t.supporting_item_ids[0]) if t.supporting_item_ids else '' %}
          <span class="post-links">
            [<a href="{{ flag_url(t.supporting_item_ids[0], 'disliked') }}">flag</a>{% if src %} · <a href="{{ src }}" target="_blank">{{ lbl }} ↗</a>{% endif %}]
          </span>
        </div>
      </div>
    </div>
    {% endfor %}
    {% endif %}

    {% if digest.trending %}
    <h2>Trending on Google</h2>
    {% for p in digest.trending %}
    <div class="trend-row">
      <span class="trend-q">{{ p.query }}</span>
      <svg class="spark" viewBox="0 0 120 28"><polyline fill="none" stroke="#111" stroke-width="2" points="{{ sparkline(p.wow_percent) }}"/></svg>
      <span class="trend-d">{{ '+' if p.wow_percent >= 0 else '' }}{{ p.wow_percent|round(0)|int }}% WoW</span>
    </div>
    {% endfor %}
    {% endif %}

    {% if digest.quotes %}
    <h2>Quotes of the day</h2>
    {% for q in digest.quotes %}
    <div class="quote-card">
      <div class="quote-text">"{{ q.text }}"</div>
      <div class="quote-src">
        <span class="pill">{{ q.source_label }}</span>
        {{ q.engagement_label }}
        <span class="post-links">
          [<a href="{{ flag_url(q.item_id, 'quote') }}">flag</a>{% if q.url %} · <a href="{{ q.url }}" target="_blank">source ↗</a>{% endif %}]
        </span>
      </div>
    </div>
    {% endfor %}
    {% endif %}

    {% if appstore_items %}
    <h2>App Store reviews</h2>
    {% for it in appstore_items[:5] %}
    <div class="appstore-row">
      {% set stars = it.engagement.get('stars', 0) %}
      {% set title_line = it.text.split('\n')[0] %}
      {% set body_line  = it.text.split('\n')[1] if '\n' in it.text else '' %}
      <div class="appstore-title">
        <span class="stars">{{ '★' * stars }}{{ '☆' * (5 - stars) }}</span>
        {{ title_line }}
      </div>
      {% if body_line %}
      <div class="appstore-body">{{ body_line[:220] }}{% if body_line|length > 220 %}…{% endif %}</div>
      {% endif %}
      <div class="appstore-meta">
        <span class="pill appstore">App Store · US</span>
        <span class="post-links">
          [<a href="{{ it.url }}" target="_blank">source ↗</a>]
        </span>
      </div>
    </div>
    {% endfor %}
    {% endif %}

    {% if digest.leadership_mentions %}
    <div class="leadership">
      <div class="leadership-title">Leadership mentions</div>
      {% for m in digest.leadership_mentions %}
      <div class="row">
        <div class="row-body">
          <div class="row-title">{{ m.text }}</div>
          <div class="row-meta"><span class="pill">{{ m.source_label }}</span><a href="{{ m.url }}" target="_blank">source ↗</a></div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="hair"></div>

    <div class="foot">
      Sources: {{ digest.methodology_sources|join(", ") }}. {{ digest.methodology_window }}.
      Every claim above cites underlying items; quotes verified verbatim.
      · <a href="#">Methodology</a> · <a href="#">Keyword list</a> · <a href="#">Unsubscribe</a>
    </div>

  </div></div>
</body>
</html>
