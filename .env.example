# Nibbles Listening Engine — environment variables
# Copy this to .env and fill in real values. .env must never be committed.

ANTHROPIC_API_KEY=sk-ant-...

# Reddit OAuth — register a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=nibbles-listening/0.1 by u/your_reddit_username

# Resend — transactional email (https://resend.com)
RESEND_API_KEY=re_...
DIGEST_FROM=pulse@alerts.nibbles.com
DIGEST_TO=mariel@nibbles.com,team@nibbles.com
